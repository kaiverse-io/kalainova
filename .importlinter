[importlinter]
root_packages =
    kalainova

# ── PROJECT BOUNDARY CONTRACTS SLOT ─────────────────────────────────────────
# Add import contracts here as your architecture firms up.
# No contracts = linter passes (nothing to check).
#
# Example — forbid cloud SDK in core layer:
#
# [importlinter:contract:no-cloud-in-core]
# name = No cloud SDK in core
# type = forbidden
# source_modules =
#     kalainova.core
# forbidden_modules =
#     boto3
#     botocore
#     azure
#     google.cloud
#
# See: https://import-linter.readthedocs.io/en/stable/contract_types.html

[importlinter:contract:kit-rules-stay-pure]
name = Kit rules import nothing from the engine, so the stdlib gate can use them
type = forbidden
source_modules =
    kalainova.kitrules
forbidden_modules =
    kalainova.jobfs
    kalainova.kits
    kalainova.consistency
    kalainova.providers

[importlinter:contract:kits-know-no-models]
name = Kits and the blob store know nothing about models or publishing
type = forbidden
source_modules =
    kalainova.kits
    kalainova.blobstore
forbidden_modules =
    kalainova.providers
    kalainova.publish

[importlinter:contract:measuring-spends-nothing]
name = The bar and an editor's decisions reach no model, so reading a piece never costs anything
type = forbidden
source_modules =
    kalainova.bar
    kalainova.editor.choose
    kalainova.render.spec
forbidden_modules =
    kalainova.providers
    kalainova.publish
    kalainova.assets

[importlinter:contract:a-record-cannot-publish]
name = A verdict, a provenance report, and a timeline export cannot reach the publisher
type = forbidden
source_modules =
    kalainova.verdicts
    kalainova.provenance
    kalainova.nle
forbidden_modules =
    kalainova.publish
    kalainova.providers
