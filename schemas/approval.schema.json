{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalainova/approval-0.1.json",
  "title": "Human approval",
  "description": "Written by a human. Binds to the exact bytes that passed QA.",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "reviewer",
    "approved_at",
    "artifact_sha256",
    "platforms"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "job_id": {
      "type": "string"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "synthetic_disclosure": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "privacy": {
      "enum": [
        "public",
        "unlisted",
        "private"
      ]
    },
    "master_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "The delivery master QA checked, when the job has one."
    }
  }
}
