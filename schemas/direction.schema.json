{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalainova/direction-0.1.json",
  "title": "Direction",
  "description": "The operator's editing notes, oldest first, and the settings they resolve to.",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "job_id": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "text"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "settings": {
      "type": "object"
    }
  }
}
