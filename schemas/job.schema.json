{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalainova/job-0.1.json",
  "title": "Kalainova job",
  "type": "object",
  "required": ["schema_version", "job_id", "strategy", "media", "rights", "status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "job_id": { "type": "string", "minLength": 1 },
    "strategy": {
      "enum": [
        "funded-clip",
        "owned-derivative",
        "generated",
        "procedural",
        "audio-native",
        "text-pack",
        "downstream-sku"
      ]
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["video", "audio", "still", "text"] }
    },
    "rights": { "enum": ["funded-brief", "owned", "licensed"] },
    "distribution_identity": { "type": ["string", "null"] },
    "status": {
      "enum": ["template", "draft", "rented", "rendered", "accepted", "measured", "killed"]
    },
    "skip_funded": {
      "type": "boolean",
      "description": "Generated jobs only. True means the operator explicitly skipped a funded-clip proof."
    },
    "cost_cap": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Currency-agnostic ceiling for rented generation on this job."
    },
    "parent_job_id": {
      "type": ["string", "null"],
      "description": "Required in practice for downstream-sku and for a stem that serves another job."
    },
    "format": {
      "enum": ["list", "comparison", "countdown", "alert", "poll", "recap", "quote", "stat"],
      "description": "Procedural jobs only."
    },
    "platforms": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
