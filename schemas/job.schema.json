{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalainova/job-0.1.json",
  "title": "Kalainova job",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "strategy",
    "media",
    "rights",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "enum": [
        "funded-clip",
        "owned-derivative",
        "generated",
        "client",
        "procedural",
        "audio-native",
        "text-pack",
        "downstream-sku"
      ]
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "video",
          "audio",
          "still",
          "text",
          "comic",
          "story",
          "song"
        ]
      }
    },
    "rights": {
      "enum": [
        "funded-brief",
        "owned",
        "licensed"
      ]
    },
    "distribution_identity": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "template",
        "draft",
        "rented",
        "rendered",
        "approved",
        "published",
        "accepted",
        "measured",
        "killed"
      ]
    },
    "skip_funded": {
      "type": "boolean",
      "description": "Generated jobs only. True means the operator explicitly skipped a funded-clip proof."
    },
    "cost_cap": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Currency-agnostic ceiling for rented generation on this job."
    },
    "parent_job_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Required in practice for downstream-sku and for a stem that serves another job."
    },
    "format": {
      "enum": [
        "list",
        "comparison",
        "countdown",
        "alert",
        "poll",
        "recap",
        "quote",
        "stat"
      ],
      "description": "Procedural jobs only."
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "brief": {
      "type": "object",
      "description": "Operator intent. The subject lives here, only in the job folder.",
      "additionalProperties": true,
      "properties": {
        "captions": {
          "enum": ["kinetic"],
          "description": "kinetic: word-timed captions drawn as a transparent layer by the graphics provider, inside the profile's safe_zone. Absent: the engine's own caption style. Film profiles burn nothing either way."
        },
        "subject": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "description": "Cut jobs: where the source file came from (origin) and the brief or licence file in the job folder that covers it (reference).",
          "properties": {
            "origin": {"type": "string"},
            "reference": {"type": "string"}
          }
        },
        "duration_sec": {
          "type": "number",
          "minimum": 3
        },
        "language": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "visual_style": {
          "type": "string"
        },
        "music": {
          "type": "string"
        },
        "max_video_beats": {
          "type": "integer",
          "minimum": 0
        },
        "cover_at_sec": {
          "type": "number",
          "minimum": 0,
          "description": "Take the cover frame at this time instead of the picker's choice."
        },
        "cover_file": {
          "type": "string",
          "description": "A picture in the job's work folder to use as the cover instead of a frame."
        },
        "animatic_gate": {
          "type": "boolean",
          "description": "When true, the assets stage pays for no video until the animatic has a verdict of accept."
        },
        "client": {
          "type": "string",
          "description": "Client label for strategy client. The deliverable goes to their accounts; they hold the rights."
        }
      }
    },
    "providers": {
      "type": "object",
      "description": "Per-job provider list by capability. It replaces the studio list, and only listed providers are tried.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "profile": {
      "type": "string",
      "description": "Name from config/studio.yaml profiles."
    },
    "animatic_reviewed": {
      "type": "object",
      "description": "Written by `kalainova verdict --animatic`: a person's verdict on the rough cut, and which cut it was.",
      "required": ["verdict", "reviewer", "at", "animatic_sha256"],
      "additionalProperties": false,
      "properties": {
        "verdict": {"enum": ["accept", "fix", "reject"]},
        "reviewer": {"type": "string", "minLength": 1},
        "at": {"type": "string"},
        "animatic_sha256": {"type": "string"},
        "stills": {
          "type": "object",
          "description": "sha256 hash of each accepted still at the time of animatic review.",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": true
    },
    "synthetic_disclosure": {
      "type": "boolean",
      "description": "Publish sets the platform AI label. Default true."
    },
    "stream": {
      "type": "string",
      "description": "The stream this job belongs to. It then needs kit.lock.json."
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Character roles from the stream that appear in this job."
    },
    "fingerprint": {
      "type": "object",
      "description": "Engine and configuration fingerprint recorded for this job.",
      "required": ["engine_version", "git_sha", "prompts_hash", "config_hash"],
      "additionalProperties": true,
      "properties": {
        "engine_version": {"type": "string"},
        "git_sha": {"type": "string"},
        "prompts_hash": {"type": "string"},
        "config_hash": {"type": "string"},
        "models": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
