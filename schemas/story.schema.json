{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalainova/story-0.1.json",
  "title": "Story",
  "type": "object",
  "required": ["schema_version", "job_id", "title", "chapters"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "job_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "byline": { "type": "string" },
    "language": { "type": "string" },
    "cover_art": { "type": "string", "description": "A prompt for the cover. It carries no words." },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "paragraphs"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
