{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalainova/stream-0.1.json",
  "title": "Stream: one identity, one strategy, its kits and limits",
  "description": "A channel, an account, or a series. Holds handles, never credentials.",
  "type": "object",
  "required": [
    "schema_version",
    "stream_id",
    "strategy",
    "distribution_identity",
    "rights",
    "media",
    "max_per_day",
    "cost_cap_per_job"
  ],
  "additionalProperties": false,
  "$defs": {
    "pin": {
      "type": "object",
      "required": [
        "provider",
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "stream_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "enum": [
        "funded-clip",
        "owned-derivative",
        "generated",
        "client",
        "procedural",
        "audio-native",
        "text-pack",
        "downstream-sku"
      ]
    },
    "distribution_identity": {
      "type": "string",
      "minLength": 1
    },
    "rights": {
      "enum": [
        "funded-brief",
        "owned",
        "licensed"
      ]
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "video",
          "audio",
          "still",
          "text"
        ]
      }
    },
    "profile": {
      "type": "string"
    },
    "max_per_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "cost_cap_per_job": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "kits": {
      "type": "object",
      "description": "Role to an exact kit version, as <kit>@<version>.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*@[0-9]+$"
      }
    },
    "generators": {
      "type": "object",
      "description": "The one provider and model per capability. No fallback.",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/pin"
        },
        "video": {
          "$ref": "#/$defs/pin"
        }
      }
    },
    "accounts": {
      "type": "object",
      "description": "Platform to account handle on this identity.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "skip_funded": {
      "type": "boolean"
    },
    "amplification_allowed": {
      "type": "boolean",
      "description": "Off unless the operator opens it. In character, never an ad."
    },
    "restricted_tier": {
      "type": "object",
      "description": "Off by default. Turned on by a human. The output is a file for a person to place, never a post.",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "enabled_by": {
          "type": "string"
        }
      }
    }
  }
}
