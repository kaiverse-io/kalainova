{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalainova/script_packet-0.1.json",
  "title": "Script packet",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "beats"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "target_duration_sec": {
      "type": "number",
      "minimum": 0
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "hook",
              "body",
              "payoff",
              "cta"
            ]
          },
          "text": {
            "type": "string"
          },
          "visual_cue": {
            "type": "string"
          },
          "audio_cue": {
            "type": "string"
          },
          "on_screen": {
            "type": "string"
          },
          "visual_kind": {
            "enum": [
              "still",
              "video"
            ]
          },
          "emphasis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cast": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Roles visible in this beat. Empty means no people in frame."
          },
          "speaker": {
            "type": "string",
            "description": "The role whose locked voice reads this line."
          },
          "looks": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Role to a look its kit holds."
          },
          "location": {
            "type": "string"
          },
          "props": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shot": {
            "type": "object",
            "additionalProperties": false,
            "description": "One shot, written apart: how it starts, how it ends, and what moves between them.",
            "properties": {
              "size": {
                "type": "string",
                "description": "wide, medium, close, or a word an editor would use."
              },
              "first_frame": {
                "type": "string",
                "description": "The still picture at the start. Nothing is happening yet in this text."
              },
              "last_frame": {
                "type": "string",
                "description": "The still picture at the end."
              },
              "camera": {
                "type": "string",
                "description": "How the camera moves, and what it reveals when it stops."
              },
              "action": {
                "type": "string",
                "description": "What the subject does, start to finish."
              },
              "environment": {
                "type": "string",
                "description": "What else moves: water, smoke, cloud, crowd."
              },
              "sound": {
                "type": "string",
                "description": "What the shot sounds like, for a model that makes sound with the picture."
              }
            }
          },
          "continues": {
            "type": "boolean",
            "description": "This shot picks up where the last one ended, so it starts from that clip's last frame."
          },
          "ambience": {
            "type": "string",
            "description": "The sound of the place under this beat."
          },
          "on_camera": {
            "type": "boolean",
            "description": "The speaker is seen saying the line, so the clip is lip-synced to it."
          },
          "duration_sec": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "How long the beat runs when no voice sets its length."
          },
          "graphics": {
            "type": "string",
            "description": "A composition folder in the job, rendered as this shot instead of generated."
          }
        }
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "description": "Every factual statement in the beats. Empty if the piece states no fact.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "finding": {
            "type": "string",
            "description": "The research finding this claim states."
          }
        }
      }
    },
    "format": {
      "type": "string"
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string"
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "chosen_hook": {
      "type": "integer",
      "minimum": 0,
      "description": "Index of the hook used in the first beat."
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "description": "What must stay the same across shots, described once and reused word for word.",
      "properties": {
        "people": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "places": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "props": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
