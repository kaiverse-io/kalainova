{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalainova/comic_script-0.1.json",
  "title": "Comic script",
  "description": "Pages, panels, and the words on them. Art prompts never carry the words: the engine letters every page.",
  "type": "object",
  "required": ["schema_version", "job_id", "title", "pages"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "job_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "style": { "type": "string" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rows", "panels"],
        "additionalProperties": false,
        "properties": {
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["height", "widths"],
              "additionalProperties": false,
              "properties": {
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "widths": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            }
          },
          "panels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "art"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "art": { "type": "string", "minLength": 1 },
                "cast": { "type": "array", "items": { "type": "string" } },
                "location": { "type": "string" },
                "looks": { "type": "object" },
                "props": { "type": "array", "items": { "type": "string" } },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["kind", "text"],
                    "additionalProperties": false,
                    "properties": {
                      "kind": { "enum": ["speech", "thought", "caption", "sfx"] },
                      "text": { "type": "string", "minLength": 1 },
                      "speaker_at": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": { "type": "number", "minimum": 0, "maximum": 1 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
