{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalainova/takes-0.1.json",
  "title": "Takes",
  "description": "Every attempt at a shot or a song, what each was read as, and which one the piece uses.",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "shots"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "shots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "chosen",
          "chosen_by",
          "takes"
        ],
        "additionalProperties": false,
        "properties": {
          "chosen": {
            "type": "integer",
            "minimum": 0
          },
          "chosen_by": {
            "enum": [
              "reading",
              "human",
              "none_passed"
            ]
          },
          "takes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "n",
                "seed",
                "file",
                "ok"
              ],
              "additionalProperties": false,
              "properties": {
                "n": {
                  "type": "integer",
                  "minimum": 0
                },
                "seed": {
                  "type": "integer",
                  "minimum": 0
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string"
                },
                "provider": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "prompt": {
                  "type": "string"
                },
                "readings": {
                  "type": "object"
                },
                "ok": {
                  "type": "boolean"
                },
                "note": {
                  "type": "string"
                },
                "cost": {
                  "type": "number",
                  "minimum": 0
                },
                "retake": {
                  "type": "boolean",
                  "description": "Asked for after the piece was looked at, so it counts against the retake limits."
                },
                "bench": {
                  "type": "boolean",
                  "description": "A camera test: made to compare models, and never chosen over a real take."
                },
                "conditioning": {
                  "type": "string",
                  "description": "What a bench take's model was given (start frame, references), so takes given different inputs are not compared as equals."
                },
                "meta": {
                  "type": "object"
                },
                "made_with": {
                  "type": "object",
                  "description": "What made the take beyond its model and prompt (ADR 0027): the engine, the merged knowledge, the directions given, the judges' setup, and the inputs' hashes.",
                  "properties": {
                    "engine": {"type": "string"},
                    "knowledge": {"type": "string"},
                    "judges": {"type": "string"},
                    "directions": {"type": "array", "items": {"type": "string"}},
                    "inputs": {"type": "object", "additionalProperties": {"type": "string"}}
                  },
                  "required": ["engine", "knowledge", "directions"],
                  "additionalProperties": false
                },
                "words": {
                  "type": "array"
                },
                "repaired_from": {
                  "type": "integer",
                  "minimum": 0
                },
                "repair_section": {
                  "type": ["string", "null"]
                },
                "repair_span": {
                  "type": "array",
                  "prefixItems": [
                    {"type": "number", "minimum": 0},
                    {"type": "number", "exclusiveMinimum": 0}
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                "master": {
                  "type": "object",
                  "description": "A master option of a song take (song_master.py, ADR 0029): the take it came from, the vocal move, the reference it was matched to, the level, and how it read once encoded. A person hears the options blind and chooses one.",
                  "required": ["from_take", "vocal_db", "level"],
                  "additionalProperties": false,
                  "properties": {
                    "from_take": {"type": "integer", "minimum": 0},
                    "source_sha256": {"type": ["string", "null"]},
                    "vocal_db": {"type": "number"},
                    "reference": {
                      "type": ["object", "null"],
                      "required": ["name", "sha256"],
                      "properties": {"name": {"type": "string"}, "sha256": {"type": "string"}}
                    },
                    "level": {"type": "string", "minLength": 1},
                    "stems": {"type": ["object", "null"]},
                    "matchering": {"type": ["object", "null"]},
                    "encoded": {"type": "object"},
                    "heard_by": {"type": ["string", "null"]}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
