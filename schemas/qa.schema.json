{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalainova/qa-0.1.json",
  "title": "QA report",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "passed",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "job_id": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "detail"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "judge": {
      "type": "object"
    },
    "artifacts_sha256": {
      "type": "object",
      "properties": {
        "video": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
