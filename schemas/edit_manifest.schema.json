{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalainova/edit_manifest-0.1.json",
  "title": "Edit manifest",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "runtime"
  ],
  "additionalProperties": false,
  "properties": {
    "asset_manifest_sha256": {
      "type": "string",
      "description": "The asset manifest this edit was cut from. When it differs, the edit is rebuilt."
    },
    "schema_version": {
      "const": "0.1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "brief": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "runtime": {
      "enum": [
        "rented-tool",
        "ffmpeg",
        "remotion"
      ],
      "description": "rented-tool until one job is accepted or measured."
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspect": {
          "enum": [
            "16:9",
            "9:16",
            "1:1",
            "4:5",
            "audio-only"
          ]
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "fps": {
          "type": "number"
        },
        "target_lufs": {
          "type": "number"
        },
        "true_peak_dbtp_max": {
          "type": "number"
        },
        "delivery": {
          "enum": [
            "web",
            "mezzanine"
          ]
        },
        "safe_zone": {
          "type": "object",
          "description": "Where interface overlays leave room, as fractions of the frame. Present only when drawn captions read it."
        }
      }
    },
    "cuts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "in_sec",
          "out_sec"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "in_sec": {
            "type": "number",
            "minimum": 0
          },
          "out_sec": {
            "type": "number",
            "minimum": 0
          },
          "role": {
            "enum": [
              "hook",
              "body",
              "payoff",
              "cta",
              "bed",
              "other"
            ]
          },
          "start_sec": {
            "type": "number",
            "minimum": 0,
            "description": "Timeline position."
          },
          "motion": {
            "enum": [
              "none",
              "push_in",
              "push_out",
              "pan_left",
              "pan_right",
              "drift_up"
            ]
          },
          "hold_last_frame": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "crop_x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Horizontal subject centre for reframing."
          },
          "crop_basis": {
            "enum": [
              "motion_centre",
              "face",
              "given",
              "default"
            ],
            "description": "What crop_x came from. motion_centre is where the picture moves, not a face."
          },
          "grade": {
            "enum": [
              "natural",
              "warm",
              "cool",
              "teal_orange",
              "film",
              "bw",
              "vivid"
            ]
          },
          "gamma": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 2
          },
          "speed": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 4
          },
          "zoom": {
            "type": "number",
            "minimum": 1,
            "maximum": 1.5
          },
          "keep_audio": {
            "type": "boolean"
          }
        }
      }
    },
    "closed_captions": {
      "type": "array",
      "description": "Sentence cues for the timed-text files. Never burned in.",
      "items": {
        "type": "object",
        "required": [
          "start_sec",
          "end_sec",
          "text"
        ],
        "properties": {
          "start_sec": {
            "type": "number",
            "minimum": 0
          },
          "end_sec": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start_sec",
          "end_sec",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "start_sec": {
            "type": "number",
            "minimum": 0
          },
          "end_sec": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "emphasis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "start_sec",
                "end_sec"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string"
                },
                "start_sec": {
                  "type": "number"
                },
                "end_sec": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voice_asset_id": {
          "type": "string"
        },
        "music_asset_id": {
          "type": "string"
        },
        "music_gain_db": {
          "type": "number"
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "asset_id",
              "start_sec"
            ],
            "additionalProperties": false,
            "properties": {
              "asset_id": {
                "type": "string"
              },
              "start_sec": {
                "type": "number",
                "minimum": 0
              },
              "gain_db": {
                "type": "number"
              }
            }
          }
        },
        "duck": {
          "type": "boolean"
        },
        "ambience": {
          "type": "array",
          "description": "The sound of each place, laid under its beat.",
          "items": {
            "type": "object",
            "required": [
              "asset_id",
              "start_sec",
              "end_sec"
            ],
            "additionalProperties": false,
            "properties": {
              "asset_id": {
                "type": "string"
              },
              "start_sec": {
                "type": "number",
                "minimum": 0
              },
              "end_sec": {
                "type": "number",
                "minimum": 0
              },
              "gain_db": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "duration_sec": {
      "type": "number",
      "minimum": 0
    },
    "caption_style": {
      "enum": [
        "studio",
        "kinetic",
        "drawn",
        "plain",
        "none"
      ]
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "start_sec",
          "end_sec"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "hook_card",
              "progress_bar",
              "lower_third",
              "end_card"
            ]
          },
          "text": {
            "type": "string"
          },
          "start_sec": {
            "type": "number",
            "minimum": 0
          },
          "end_sec": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "theme": {
      "enum": [
        "studio",
        "bold"
      ]
    },
    "transition": {
      "enum": [
        "cut",
        "dissolve"
      ]
    },
    "original_audio": {
      "type": "boolean"
    },
    "speech": {
      "type": "boolean",
      "description": "The footage's own sound is mostly someone talking, so it gets the voice chain."
    },
    "fade_in_sec": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "fade_out_sec": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "beat_grid": {
      "type": "object",
      "properties": {
        "bpm": {
          "type": "number"
        },
        "confidence": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  }
}
