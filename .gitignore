node_modules/
out/
dist/
.DS_Store
.env
.env.*

# Media stays local. scripts/check.py enforces this once the tree is a git repo.
*.mp3
*.mp4
*.wav
*.m4a
*.mov
*.webm

# operator-local denylist for scripts/lint_docs.py; never commit it
.denylist.local

# python bytecode and test cache
__pycache__/
*.pyc
.pytest_cache/

# per-job write lock
.lock

# chassis stamp (v0.14.1)
*.py[cod]
*.egg-info/
build/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.venv
.uv/
.devcontainer/devcontainer-lock.json
graphify-out/
.claude/settings.local.json
.devcontainer/claude-user-settings.json

# kit reference bytes live in a content-addressed store, not in git (ADR 0009)
store/

!.env.example

# This repo is public. Real work lives in a private $KALAINOVA_HOME (ADR 0010), and these keep a
# stray local copy out of git if someone runs without it.
jobs/*
!jobs/README.md
!jobs/_template/
kits/*
!kits/README.md
streams/*
!streams/README.md
# /ub-mode quality tools (just crap|dry|mutate): pinned tool checkouts and their reports
.cache/ub-tools/
.metrics/
target/coverage/
